                    "type": "integer"
                  },
                  "codigo": {
                    "type": "string"
                  },
                  "nombres_apellidos": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "fecha_nacimiento": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "example": {
                "carrera_id": 1,
                "codigo": "EST-99999",
                "nombres_apellidos": "Juan Perez",
                "email": "juan.perez@example.com",
                "fecha_nacimiento": "2000-05-15"
              }
            }
          }
        }
      }
    },
